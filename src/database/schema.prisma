generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// =========================================================================
// AUTH
// =========================================================================

model RefreshToken {
  id        String    @id @default(uuid()) @map("_id")
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refreshTokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @map("_id")
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("passwordResetTokens")
}

// =========================================================================
// USER
// =========================================================================

enum SystemRole {
  USER
  ADMIN
}

model User {
  id             String     @id @default(uuid()) @map("_id")
  email          String     @unique
  // auth.md #3.1/#3.2: rỗng nếu User chỉ đăng nhập qua Google (không có mật khẩu).
  passwordHash   String?
  // auth.md #3.2: Google `sub` — chỉ có khi đã liên kết/tạo tài khoản qua Google.
  // Không dùng @unique: MongoDB coi mọi document thiếu field này là cùng 1
  // giá trị null, vi phạm unique index thật ngay khi có ≥2 User chưa liên kết
  // Google — uniqueness được đảm bảo ở tầng code (auth.service.ts luôn tra
  // findUserByGoogleId trước khi ghi, chỉ 1 nơi duy nhất ghi field này).
  googleId       String?
  name           String
  avatarUrl      String?
  avatarPublicId String?
  settings       Json?
  systemRole     SystemRole @default(USER)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
  deletedBy      String?

  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  ownedWorkspaces      Workspace[]
  workspaceMemberships WorkspaceMember[]
  sentInvitations      WorkspaceInvitation[]
  createdTasks         Task[]                @relation("TaskCreator")
  comments             Comment[]
  attachments          Attachment[]
  notifications        Notification[]
  activityLogs         ActivityLog[]
  taskStars            TaskStar[]
  taskWatches          TaskWatcher[]
  docs                 Doc[]

  @@index([googleId])
  @@map("users")
}

// =========================================================================
// WORKSPACE (Workspace, Member, Invitation)
// =========================================================================

enum WorkspaceType {
  KANBAN
  SCRUM
}

enum WorkspaceVisibility {
  PUBLIC
  PRIVATE
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Workspace {
  id          String        @id @default(uuid()) @map("_id")
  name        String
  type        WorkspaceType
  description String?
  ownerId     String
  // Mã ngắn hiển thị thay UUID dài trên UI (badge), sinh ngẫu nhiên lúc tạo.
  shortCode   String        @unique
  // Ảnh đại diện dạng preset (emoji + màu nền) — user tự chọn hoặc random lúc
  // tạo Workspace, không phải ảnh upload thật (xem workspace-avatar-presets.ts).
  avatarEmoji String
  avatarColor String
  // Chỉ lưu trạng thái, CHƯA ảnh hưởng access control thực tế (đổi Permission
  // là phạm vi lớn hơn, cần xác nhận riêng).
  visibility  WorkspaceVisibility @default(PRIVATE)
  // Bộ đếm cấp Task.taskNumber tăng dần riêng theo Workspace này (mã Task
  // hiển thị "{shortCode}-{taskNumber}") — tăng atomic lúc tạo Task mới, xem
  // task.repository.ts create().
  taskCounter Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

  owner         User                  @relation(fields: [ownerId], references: [id])
  members       WorkspaceMember[]
  invitations   WorkspaceInvitation[]
  board         Board?
  sprints       Sprint[]
  notifications Notification[]
  activityLogs  ActivityLog[]
  docs          Doc[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id             String        @id @default(uuid()) @map("_id")
  workspaceId    String
  userId         String
  role           WorkspaceRole @default(MEMBER)
  invitedBy      String?
  isStarred      Boolean       @default(false)
  lastAccessedAt DateTime      @default(now())
  joinedAt       DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  deletedBy      String?

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspaceMembers")
}

model WorkspaceInvitation {
  id          String           @id @default(uuid()) @map("_id")
  workspaceId String
  email       String
  role        WorkspaceRole    @default(MEMBER)
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedBy   String
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  inviter   User      @relation(fields: [invitedBy], references: [id])

  @@index([workspaceId])
  @@index([email])
  @@map("workspaceInvitations")
}

// =========================================================================
// BOARD & COLUMN
// (Board tự sinh 1-1 theo Workspace, cấm tạo/sửa/xóa thủ công)
// =========================================================================

model Board {
  id          String    @id @default(uuid()) @map("_id")
  workspaceId String    @unique
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  columns   Column[]

  @@map("boards")
}

model Column {
  id        String    @id @default(uuid()) @map("_id")
  boardId   String
  name      String
  order     Int
  // task.md #4: mỗi Column tự là 1 trạng thái riêng (Task.status = tên Column
  // hiện tại) — isDoneColumn chỉ dùng để lọc "done"/"unfinished" (Dashboard,
  // GET /tasks/me?done=, GET /workspaces/:id/tasks?done=), không giới hạn số
  // lượng "trạng thái" Column có thể đại diện.
  isDoneColumn Boolean @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  board Board  @relation(fields: [boardId], references: [id])
  tasks Task[]

  @@index([boardId])
  @@map("columns")
}

// =========================================================================
// SPRINT (chỉ tồn tại trong Workspace type = SCRUM, enforce ở Service layer)
// =========================================================================

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

model Sprint {
  id          String       @id @default(uuid()) @map("_id")
  workspaceId String
  name        String
  goal        String?
  status      SprintStatus @default(PLANNED)
  // sprint.md #6: bắt buộc ngay lúc tạo, endDate luôn > startDate.
  startDate   DateTime
  endDate     DateTime
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  tasks     Task[]

  @@index([workspaceId])
  @@index([status])
  @@map("sprints")
}

// =========================================================================
// TASK
// =========================================================================

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

// Bổ sung theo yêu cầu (không thuộc field chuẩn task.md) — phân loại Task
// dùng cho Filter Board/List, mặc định TASK cho Task tạo theo cách thông
// thường.
enum TaskType {
  TASK
  BUG
  STORY
  EPIC
}

model Task {
  id           String       @id @default(uuid()) @map("_id")
  columnId     String
  sprintId     String?
  title        String
  description  String?
  priority     TaskPriority @default(MEDIUM)
  type         TaskType     @default(TASK)
  // Mã Task hiển thị dạng "{Workspace.shortCode}-{taskNumber}" (FE tự ghép),
  // tăng dần riêng theo từng Workspace — cấp bằng Workspace.taskCounter lúc
  // tạo Task (xem task.repository.ts create()), không phải auto-increment
  // của MongoDB (không hỗ trợ native).
  taskNumber   Int
  // task.md #4: Status không còn là enum cố định — luôn mirror đúng tên
  // Column hiện tại (mỗi Column tự là 1 "trạng thái" riêng, không giới hạn
  // 3 giá trị cũ). Luôn được service gán lại mỗi khi đổi Column, không cho
  // client tự set tuỳ ý qua PATCH /tasks/:id nữa.
  status       String
  order        Int
  backlogOrder Int?
  startDate    DateTime?
  dueDate      DateTime?
  // task.md #3 (Người dùng: assigneeIds) — Task có thể gán nhiều người cùng
  // lúc, theo quyết định của bạn (thay cho assigneeId 1 người trước đây).
  assigneeIds  String[]     @default([])
  // Bổ sung theo yêu cầu (không thuộc field chuẩn task.md #3) — hiển thị ở
  // modal chi tiết Task. storyPoints: số điểm ước lượng tự do, không ràng
  // buộc nghiệp vụ.
  storyPoints  Int?
  createdBy    String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
  deletedBy    String?

  column      Column          @relation(fields: [columnId], references: [id])
  sprint      Sprint?         @relation(fields: [sprintId], references: [id])
  creator     User            @relation("TaskCreator", fields: [createdBy], references: [id])
  comments    Comment[]
  checklist   ChecklistItem[]
  attachments Attachment[]
  // labels.md/task.md #13: mỗi Task tự có Label riêng (không dùng chung giữa
  // các Task), theo quyết định của bạn — không phải Label cấp Workspace.
  labels      Label[]
  stars       TaskStar[]
  watchers    TaskWatcher[]

  @@index([columnId])
  @@index([sprintId])
  @@index([assigneeIds])
  @@index([status])
  @@index([dueDate])
  @@index([type])
  @@map("tasks")
}

// Đánh dấu sao cho Task theo từng user (bookmark cá nhân, không phải business
// record cần audit) — hard delete khi unstar, không áp dụng soft-delete.
model TaskStar {
  id        String   @id @default(uuid()) @map("_id")
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("taskStars")
}

// =========================================================================
// COMMENT / CHECKLIST / ATTACHMENT
// =========================================================================

model Comment {
  id        String    @id @default(uuid()) @map("_id")
  taskId    String
  authorId  String
  content   String
  // comment.md #3: mentions (optional) — userId của các Member được @mention.
  mentions  String[]  @default([])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  task   Task @relation(fields: [taskId], references: [id])
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId])
  @@map("comments")
}

// docs.md #3: content lưu nguyên JSON do Frontend gửi lên (rich-text editor),
// Backend không hiểu/không xử lý cấu trúc bên trong.
model Doc {
  id          String    @id @default(uuid()) @map("_id")
  workspaceId String
  title       String
  content     Json?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  author    User      @relation(fields: [createdBy], references: [id])

  @@index([workspaceId])
  @@map("docs")
}

// checklist.md #10: Checklist không hỗ trợ Soft Delete riêng — tuân theo
// chính sách của Task (Task xóa mềm thì Checklist không hiển thị), nên
// không có deletedAt/deletedBy ở đây, xóa Checklist là hard delete thật.
model ChecklistItem {
  id          String    @id @default(uuid()) @map("_id")
  taskId      String
  title       String
  isDone      Boolean   @default(false)
  order       Int
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  task Task @relation(fields: [taskId], references: [id])

  @@index([taskId])
  @@map("checklistItems")
}

// Label riêng theo từng Task (không tái sử dụng giữa các Task khác), theo
// quyết định của bạn — task.md #13 gợi ý Label entity dùng chung cấp
// Workspace (label.md) nhưng chưa áp dụng ở đây.
model Label {
  id        String   @id @default(uuid()) @map("_id")
  taskId    String
  name      String
  color     String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id])

  @@index([taskId])
  @@map("labels")
}

// Watcher theo dõi Task để nhận Notification, không phải Assignee. Theo
// quyết định của bạn: Owner/Admin được thêm Watcher cho bất kỳ Member nào
// (không chỉ tự thêm chính mình) — hard delete khi unwatch, không audit.
model TaskWatcher {
  id        String   @id @default(uuid()) @map("_id")
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("taskWatchers")
}

model Attachment {
  id           String    @id @default(uuid()) @map("_id")
  taskId       String
  uploaderId   String
  fileName     String
  fileUrl      String
  filePublicId String
  fileSize     Int
  mimeType     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedBy    String?

  task     Task @relation(fields: [taskId], references: [id])
  uploader User @relation(fields: [uploaderId], references: [id])

  @@index([taskId])
  @@map("attachments")
}

// =========================================================================
// NOTIFICATION (system-generated, scoped theo Workspace)
// =========================================================================

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  COMMENT_ADDED
  MENTION
  WORKSPACE_INVITATION
  SPRINT_STARTED
  SPRINT_COMPLETED
  ATTACHMENT_ADDED
}

model Notification {
  id          String           @id @default(uuid()) @map("_id")
  workspaceId String
  recipientId String
  type        NotificationType
  title       String
  message     String
  metadata    Json?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  recipient User      @relation(fields: [recipientId], references: [id])

  @@index([workspaceId])
  @@index([recipientId])
  @@index([isRead])
  @@map("notifications")
}

// =========================================================================
// ACTIVITY LOG (append-only — cấm sửa/xóa, không có updatedAt/deletedAt)
// =========================================================================

model ActivityLog {
  id          String   @id @default(uuid()) @map("_id")
  workspaceId String
  actorId     String
  entityType  String
  entityId    String
  action      String
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  actor     User      @relation(fields: [actorId], references: [id])

  @@index([workspaceId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activityLogs")
}
