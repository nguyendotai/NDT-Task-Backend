{
  "info": {
    "_postman_id": "b3f2a6b0-6d3e-4c1a-9a2e-0f7b1d4c9e21",
    "name": "NDT Task API",
    "description": "Collection theo đúng đặc tả trong `.claude/api-spec.md`. CHỈ chứa endpoint đã được document chính thức — không tự suy đoán thêm endpoint chưa có trong api-spec.md. Cập nhật đồng thời với api-spec.md mỗi khi API thay đổi (xem backend/CLAUDE.md mục 5).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "workspaceId", "value": "", "type": "string" },
    { "key": "memberId", "value": "", "type": "string" },
    { "key": "invitationId", "value": "", "type": "string" },
    { "key": "invitationToken", "value": "", "type": "string" },
    { "key": "newOwnerId", "value": "", "type": "string" },
    { "key": "columnId", "value": "", "type": "string" },
    { "key": "taskId", "value": "", "type": "string" },
    { "key": "resetToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user1@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Test User\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Đăng ký user mới. Response data: id, email, name."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user1@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Đăng nhập. Tự động lưu accessToken vào biến collection qua Test script. refreshToken được set ở HTTP-Only Cookie (Postman cookie jar tự lưu)."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "description": "Đăng xuất. Set cookie refreshToken thành empty/expired."
          },
          "response": []
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Làm mới Access Token bằng refreshToken cookie (Postman cookie jar tự gửi). Refresh Token được rotate, tự động cập nhật accessToken vào biến collection."
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user1@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "forgot-password"]
            },
            "description": "Luôn trả 200 với message chung chung (chống user-enumeration). Nếu email tồn tại, token reset được gửi qua email (Queue) — cần lấy {{resetToken}} từ email hoặc DB để test Reset Password."
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"newPassword456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "reset-password"]
            },
            "description": "Đặt lại mật khẩu bằng token nhận từ Forgot Password. Thành công sẽ revoke toàn bộ refresh token hiện có của user."
          },
          "response": []
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            },
            "description": "Lấy profile của user đang đăng nhập (Bearer token)."
          },
          "response": []
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\",\n  \"settings\": {\n    \"theme\": \"dark\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            },
            "description": "Cập nhật name/settings. Không nhận avatarUrl trực tiếp — dùng Upload Avatar bên dưới."
          },
          "response": []
        },
        {
          "name": "Upload Avatar",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": [] }]
            },
            "url": {
              "raw": "{{baseUrl}}/users/me/avatar",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "avatar"]
            },
            "description": "Upload ảnh avatar (JPEG/PNG/WEBP, tối đa 5MB) — chọn file ở tab Body > form-data. Lưu vào Cloudinary, overwrite avatar cũ."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Workspace",
      "item": [
        {
          "name": "Create Workspace",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('workspaceId', body.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Workspace\",\n  \"type\": \"KANBAN\",\n  \"description\": \"Sample workspace for testing\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workspaces",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces"]
            },
            "description": "Tạo Workspace (type: KANBAN | SCRUM). Tự động lưu workspaceId vào biến collection."
          },
          "response": []
        },
        {
          "name": "List My Workspaces",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/workspaces",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces"]
            },
            "description": "Danh sách Workspace mà user hiện tại là Member Active (kèm myRole)."
          },
          "response": []
        },
        {
          "name": "Get Workspace By Id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceId}}"]
            },
            "description": "Lấy chi tiết Workspace (kèm membersCount)."
          },
          "response": []
        },
        {
          "name": "Update Workspace",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Workspace Updated\",\n  \"description\": \"Updated description\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceId}}"]
            },
            "description": "Chỉ Owner. Không đổi được type/ownerId."
          },
          "response": []
        },
        {
          "name": "Delete Workspace",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceId}}"]
            },
            "description": "Chỉ Owner. Soft delete cascade Workspace/Board/Column/Member/Invitation."
          },
          "response": []
        },
        {
          "name": "Transfer Owner",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newOwnerId\": \"{{newOwnerId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/transfer-owner",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceId}}", "transfer-owner"]
            },
            "description": "Chỉ Owner. newOwnerId phải là userId của một Member Active — set thủ công từ List Members."
          },
          "response": []
        },
        {
          "name": "Leave Workspace",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/leave",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceId}}", "leave"]
            },
            "description": "Admin/Member. Owner không được rời (403) — phải Transfer Owner trước."
          },
          "response": []
        },
        {
          "name": "List Members",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/members",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceId}}", "members"]
            },
            "description": "Danh sách Member Active. Lấy id (memberId) và user.id (newOwnerId) từ đây để set thủ công cho các request bên dưới."
          },
          "response": []
        },
        {
          "name": "Invite Member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('invitationId', body.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user2@example.com\",\n  \"role\": \"MEMBER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/members/invite",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceId}}", "members", "invite"]
            },
            "description": "Owner/Admin. role chỉ được ADMIN hoặc MEMBER. Gửi email chứa link mời (best-effort qua Queue) — lấy {{invitationToken}} từ email hoặc DB để test Accept/Reject."
          },
          "response": []
        },
        {
          "name": "List Pending Invitations",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/invitations",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceId}}", "invitations"]
            },
            "description": "Owner/Admin. Chỉ liệt kê lời mời đang PENDING."
          },
          "response": []
        },
        {
          "name": "Revoke Invitation",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/invitations/{{invitationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceId}}", "invitations", "{{invitationId}}"]
            },
            "description": "Owner/Admin. Chỉ áp dụng cho lời mời đang PENDING."
          },
          "response": []
        },
        {
          "name": "Accept Invitation",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/workspaces/invitations/{{invitationToken}}/accept",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "invitations", "{{invitationToken}}", "accept"]
            },
            "description": "Đăng nhập bằng tài khoản có email khớp lời mời trước khi gọi. Không yêu cầu là Member sẵn có."
          },
          "response": []
        },
        {
          "name": "Reject Invitation",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/workspaces/invitations/{{invitationToken}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "invitations", "{{invitationToken}}", "reject"]
            },
            "description": "Đăng nhập bằng tài khoản có email khớp lời mời trước khi gọi."
          },
          "response": []
        },
        {
          "name": "Update Member Role",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/members/{{memberId}}/role",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceId}}", "members", "{{memberId}}", "role"]
            },
            "description": "Chỉ Owner. role chỉ được ADMIN hoặc MEMBER (dùng Transfer Owner để đổi Owner)."
          },
          "response": []
        },
        {
          "name": "Remove Member",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/members/{{memberId}}",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceId}}", "members", "{{memberId}}"]
            },
            "description": "Owner (xóa Admin/Member) hoặc Admin (chỉ xóa Member). Không thể xóa Owner hoặc tự xóa chính mình."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Task",
      "item": [
        {
          "name": "Create Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('taskId', body.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"columnId\": \"{{columnId}}\",\n  \"title\": \"Sample Task\",\n  \"description\": \"Created from Postman\",\n  \"priority\": \"MEDIUM\",\n  \"dueDate\": \"2026-08-15T00:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"]
            },
            "description": "Tạo Task trong 1 Column. api-spec.md chưa có endpoint tạo Board/Column, nên tạm thời set {{columnId}} thủ công (ví dụ lấy trực tiếp từ MongoDB) cho tới khi module Board/Column được implement."
          },
          "response": []
        }
      ]
    }
  ]
}
